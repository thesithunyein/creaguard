# Storage (Vercel KV / Upstash Redis). Vercel injects these automatically after
# you create a KV store in the project dashboard.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Real analysis backend. Leave unset and CreaGuard reports "not configured"
# instead of returning fabricated results.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct

# Minds by Animoca Brands (official @animocabrands/minds-client-lib).
MINDS_BUILDER_API_KEY=
MINDS_MIND_ID=

# Internal secret for the scheduled follow-up endpoint.
CRON_SECRET=

# Discord slash command intake (/review). From the Discord Developer Portal.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
