# Storage (Vercel KV / Upstash Redis). Vercel injects these automatically after
# you create a KV store in the project dashboard.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Real analysis backend. Leave unset and CreaGuard reports "not configured"
# instead of returning fabricated results.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct

# Minds by Animoca Brands (official @animocabrands/minds-client-lib).
MINDS_BUILDER_API_KEY=
MINDS_MIND_ID=

# Auth (optional): Clerk. Without these the app runs as a single demo
# workspace. With them, each signed-in creator gets a private workspace.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Single-tenant workspace. When set, the signed-in creator AND the channel
# webhooks (which have no session) share this one workspace, so the dashboard
# and your bots stay in sync. Leave empty to give each signed-in creator a
# separate workspace. Defaults to "demo".
WORKSPACE_ID=demo

# Internal secret for the scheduled follow-up and digest endpoints.
CRON_SECRET=

# Telegram chat that receives the morning digest (numeric id). When empty,
# the digest falls back to the most recent chat the bot has talked to.
DIGEST_TELEGRAM_CHAT_ID=

# Discord slash command intake (/review). From the Discord Developer Portal.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

# Telegram bot intake. Create a bot with @BotFather. TELEGRAM_BOT_SECRET is
# your own random string and must match the webhook secret_token set by
# scripts/setup-telegram.mjs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_SECRET=

# YouTube comment import (video-URL based, API key only, no OAuth). Get a key
# from Google Cloud Console > APIs & Services > Credentials.
YOUTUBE_API_KEY=
